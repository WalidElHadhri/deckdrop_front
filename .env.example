# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.
# NODE_ENV is also read (secure cookies in production) but is set automatically by Next.js and Vercel.

# Spring Boot backend base URL, no trailing slash. Falls back to http://localhost:8080 when unset.
NEXT_PUBLIC_API_URL=

# Stripe publishable key (pk_test_... / pk_live_...); card payments are shown as unavailable when unset.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
